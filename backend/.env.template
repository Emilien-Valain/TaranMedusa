ADMIN_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
AUTH_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres@localhost/$DB_NAME
DB_NAME=Taran

# SMTP (OVH)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@votre-domaine.fr
SMTP_PASSWORD=votre-mot-de-passe
SMTP_FROM="Taran <contact@votre-domaine.fr>"

# URLs (à adapter selon l'environnement)
STORE_URL=http://localhost:8000
ADMIN_URL=http://localhost:7001
ADMIN_NOTIFICATION_EMAIL=admin@votre-domaine.fr

# Secret partagé avec le storefront pour la revalidation à la demande
# (doit être identique à REVALIDATE_SECRET dans storefront/.env)
REVALIDATE_SECRET=supersecret

# INSEE Sirene (validation automatique des SIRET) — clé sur portail-api.insee.fr
INSEE_API_KEY=

# Colissimo — Web Service Affranchissement
# Auth recommandée : apiKey. Sinon repli contrat + mot de passe (déprécié).
